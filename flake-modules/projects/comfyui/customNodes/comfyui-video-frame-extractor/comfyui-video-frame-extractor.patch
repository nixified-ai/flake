+def _read_webp_frames(video_path: str, indices: list) -> np.ndarray:
+    indices_set = set(indices)
+    max_idx = max(indices) if indices else 0
+    frames_dict = {}
+    with Image.open(video_path) as img:
+        w, h = img.size
+        for i in range(min(max_idx + 1, getattr(img, "n_frames", 1))):
+            if i in indices_set:
+                img.seek(i)
+                frames_dict[i] = np.array(img.convert("RGB"))
+    
+    arr = np.empty((len(indices), h, w, 3), dtype=np.uint8)
+    for i, idx in enumerate(indices):
+        if idx in frames_dict:
+            arr[i] = frames_dict[idx]
+        else:
+            arr[i] = np.zeros((h, w, 3), dtype=np.uint8)
+    return arr
+
